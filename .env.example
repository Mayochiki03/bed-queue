# ============================================================
# ไฟล์ตั้งค่าตัวเดียวของทั้งระบบ (backend + frontend อ่านไฟล์นี้ไฟล์เดียว)
# ไม่มีไฟล์ .env ก็รันได้ (ถ้าเตรียมฐานข้อมูลตาม database/README.md แล้ว) — สร้างเมื่อต้องการเปลี่ยนค่า:  npm run setup
# ============================================================

# ---- ชื่อและหน้าตา ----
APP_NAME=ระบบคิวขอเตียง
APP_THEME=care            # care (เขียวน้ำเงิน) | herb (เขียว-ครีม) | ocean | rose | slate | indigo | amber | graphite — เพิ่มชุดสีเองที่ frontend/src/theme.css

# ---- พอร์ต ----
PORT=4000                 # พอร์ตของ API (หน้าเว็บ proxy ไปหาพอร์ตนี้เอง)
WEB_PORT=5173             # พอร์ตของหน้าเว็บตอนพัฒนา

# ---- ฐานข้อมูล: mariadb (ค่าเริ่มต้น) | mysql | postgres ----
# ต้องเตรียมฐานข้อมูลก่อน — ดู database/README.md (ค่าด้านล่างตรงกับ database/init.sql)
# ตารางไม่ต้องสร้างเอง ระบบสร้างให้ตอนรัน
DB_CLIENT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306              # postgres = 5432
DB_NAME=bed_queue
DB_USER=app
DB_PASSWORD=app_password  # สำคัญ: production ต้องเปลี่ยน (ระบบไม่ยอมเริ่มถ้ายังเป็นค่านี้)

# ---- ความปลอดภัย ----
# JWT_SECRET=             # npm run setup จะสุ่มให้ — production ต้องตั้ง (ยาว 32 ตัวอักษรขึ้นไป)
# JWT_HOURS=12
# COOKIE_SECURE=true      # เปิดเมื่อใช้ HTTPS
# APP_SECRET_KEY=         # กุญแจเข้ารหัสค่าลับในฐานข้อมูล (LINE token/secret) — hex 64 ตัว; npm run setup จะสุ่มให้
#                         # สำคัญ: production ต้องตั้งเอง และห้ามทำหาย/เปลี่ยน ไม่งั้นค่าที่เข้ารหัสไว้อ่านไม่ออก (ต้องกรอกใหม่)
# TRUST_PROXY=1           # จำนวน proxy ด้านหน้า (Cloudflare Tunnel = 1) ใช้ให้ IP จริงของผู้ใช้ถูกต้อง

# ---- ผู้ดูแลระบบคนแรก (สร้างให้ตอนฐานข้อมูลยังไม่มีผู้ใช้) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!123

# ---- อื่น ๆ ----
# AUTO_MIGRATE=true       # สร้าง/อัปเดตตารางตอนเปิดระบบ (ค่าเริ่มต้น: เปิดตอนพัฒนา ปิดตอน production → สั่ง npm run migrate เอง)
