{
  // ใช้เฉพาะตอนสแกน SonarQube (ไม่กระทบ build/รันจริง)
  // SonarQube 9.9 มี TypeScript รุ่นเก่า ไม่รู้จัก moduleResolution "Bundler" และอ่านค่านี้จาก tsconfig.json ที่ extends มาด้วย
  // จึงต้องเขียนค่าทั้งหมดไว้ในไฟล์นี้เองโดยไม่ใช้ extends (ถ้าแก้ tsconfig.json ให้แก้ไฟล์นี้ให้ตรงกัน)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
